# Copia este archivo a .env.local en tu ordenador. En Hostinger, estas variables
# se pegan en el panel de la web (Variables de entorno). NUNCA se suben al repo.

# Entorno: local | staging | produccion (solo informativo, sale en /api/salud)
ENTORNO=local

# Base de datos MySQL: mysql://USUARIO:CONTRASEÑA@HOST:3306/NOMBRE_BD
DATABASE_URL=mysql://vipnails:cambia_esto@localhost:3306/vipnails

# Login (Better Auth)
# URL pública de esta web, sin barra final
BETTER_AUTH_URL=http://localhost:3000
# Secreto largo y aleatorio (mín. 32 caracteres). Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Código para crear el primer administrador en /instalar.
# Pon un valor largo, úsalo una vez y luego BÓRRALO de las variables.
INSTALAR_TOKEN=

# Migraciones automáticas al arrancar (1 = sí, 0 = no)
MIGRAR_AL_ARRANCAR=1

# Solo en producción, cuando se lance la web: permite que Google indexe
# PERMITIR_INDEXAR=1
